<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DeadlockTranslate</AssemblyName><Version>0.7.4</Version>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" /></ItemGroup>
  <ItemGroup>
    <!-- Restore only the parser assembly; rendering and texture packages are not needed for a KV3 cache. -->
    <PackageDownload Include="ValveResourceFormat" Version="[20.1.7467]" />
    <Reference Include="ValveResourceFormat">
      <HintPath>$(NuGetPackageRoot)valveresourceformat/20.1.7467/lib/net10.0/ValveResourceFormat.dll</HintPath>
    </Reference>
    <PackageReference Include="ValveKeyValue" Version="0.70.0.499" />
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.10" />
    <InternalsVisibleTo Include="BuildCatalogTests" />
  </ItemGroup>
  <ItemGroup><Content Update="data\**;wwwroot\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
</Project>
