<root>
    <styles>
        <include src="s2r://panorama/styles/citadel_base_styles.vcss_c" />
        <include src="s2r://panorama/styles/dlt_settings_window.vcss_c" />
    </styles>
    <scripts><include src="s2r://panorama/scripts/dlt_settings_window.vjs_c" /></scripts>
    <Panel class="DltWindowOverlay" hittest="true" hittestchildren="true" onactivate="DLTSettingsKeepOpen();" oncancel="DLTSettingsClose('escape');">
        <Panel class="DltWindowBackdrop" hittest="false" hittestchildren="false" />
        <Panel class="DltSettingsWindow" hittest="true" hittestchildren="true" acceptsinput="true" onactivate="DLTSettingsKeepOpen();">
            <Panel class="DltWindowTitleBar">
                <Label class="DltWindowTitle" text="翻译设置" />
                <Label id="DltWindowStatus" text="正在连接本地设置…" />
                <Panel class="DltWindowActions">
                    <Button class="DltWindowButton" onactivate="DLTSettingsRetry();"><Label text="重新加载" /></Button>
                    <Button class="DltWindowButton" onactivate="DLTSettingsClose();"><Label text="关闭  ×" /></Button>
                </Panel>
            </Panel>
            <HTML id="DltSettingsPage" class="DltSettingsPage" hittest="true" hittestchildren="true" acceptsinput="true" acceptsfocus="true" />
        </Panel>
    </Panel>
</root>
