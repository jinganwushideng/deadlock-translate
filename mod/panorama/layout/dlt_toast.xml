<root>
    <styles>
        <include src="s2r://panorama/styles/citadel_base_styles.vcss_c" />
        <include src="s2r://panorama/styles/dlt_toast.vcss_c" />
    </styles>
    <Panel class="DltToastViewport" hittest="false" hittestchildren="false" acceptsinput="false" acceptsfocus="false">
