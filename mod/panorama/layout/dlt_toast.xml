                    </Panel>
                    <Panel class="DltToastDiamond" />
                    <Label id="DltToastBalance" class="DltToastChip" html="false" />
                </Panel>
            </Panel>
            <Panel class="DltToastBadge">
                <Label class="DltToastBadgePrimary" text="文" html="false" />
                <Label class="DltToastBadgeSecondary" text="A" html="false" />
            </Panel>
        </Panel>
    </Panel>
